<?php
// Local configuration for Cub Scouts app (do not commit the real config.local.php)
//
// Copy this file to config.local.php and fill in your environment-specific values.

define('DB_HOST', '');
define('DB_NAME', '');
define('DB_USER', '');
define('DB_PASS', '');

// Application branding (used as a fallback; UI will prefer Settings::get('site_title', APP_NAME))
define('APP_NAME', 'Cub Scouts');

// Optional super password (for temporary testing). Leave blank to disable.
define('SUPER_PASSWORD', ''); // e.g., 'super' (REMOVE/DISABLE IN PRODUCTION)

// SMTP configuration (e.g., Gmail with App Password)
define('SMTP_HOST', 'smtp.gmail.com'); // smtp.gmail.com
define('SMTP_PORT', 587);              // 587 for STARTTLS, 465 for SSL
define('SMTP_USER', '');               // your Gmail address
define('SMTP_PASS', '');               // app password (recommended)
define('SMTP_SECURE', 'tls');          // 'tls' or 'ssl'
define('SMTP_FROM_EMAIL', '');         // often the same as SMTP_USER
define('SMTP_FROM_NAME', 'Cub Scouts'); // From name seen in emails

// HMAC key for secure event invite links (REQUIRED for invite feature).
// Set to a long random string, e.g., bin2hex(random_bytes(32)).
define('INVITE_HMAC_KEY', '');

// HMAC key for remember me tokens (REQUIRED for persistent login).
// Set to a long random string, e.g., bin2hex(random_bytes(32)).
define('REMEMBER_TOKEN_KEY', '');

// Email debug mode - when enabled, emails are not actually sent but simulated
// Set to true to enable debug mode (useful for testing real-time progress display)
// IMPORTANT: Set to false or remove this line in production!
define('EMAIL_DEBUG_MODE', false);

// Cloudflare R2 object storage for event photos and slideshow music.
// R2 dashboard -> bucket "pack440-photos" -> Settings -> "S3 API": copy that URL
// and paste it as R2_ENDPOINT exactly as shown. It looks like
//   https://<account-id>.r2.cloudflarestorage.com/pack440-photos
// and the trailing bucket name is fine (the app strips it). Then
// "Manage R2 API Tokens" -> create a token scoped to the bucket and paste its
// Access Key ID / Secret Access Key below. "Admin Read & Write" lets
// Admin -> Photo Storage apply the bucket CORS rule for you; "Object Read &
// Write" also works, but then set the CORS policy in the Cloudflare dashboard
// (that page shows the exact JSON to paste).
// Leave the keys empty to disable photo uploads (pages still render).
define('R2_ENDPOINT', '');        // paste the S3 API URL from the bucket's Settings tab
define('R2_ACCESS_KEY', '');
define('R2_SECRET_KEY', '');
define('R2_PHOTO_BUCKET', 'pack440-photos'); // keep the bucket private
